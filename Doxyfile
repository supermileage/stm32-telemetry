# Run from the repository root: doxygen Doxyfile
PROJECT_NAME           = "STM32 telemetry"
PROJECT_BRIEF          = "Application and board support API"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = firmware/app firmware/BSP firmware/README.md
FILE_PATTERNS          = *.h *.c *.cpp *.md
EXCLUDE_PATTERNS       = */app/README.md */app/*/README.md */BSP/README.md */BSP/*/README.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE  = firmware/README.md
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES

# Show the API and source listings without pulling in vendor code or private helpers.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
ENABLE_PREPROCESSING   = YES
PREDEFINED             = __cplusplus=201703L

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
