set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "$ENV{ARM_TOOLCHAIN_BIN}" REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
get_filename_component(_arm_bin "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(CMAKE_AR arm-none-eabi-ar HINTS "${_arm_bin}" REQUIRED)
find_program(CMAKE_RANLIB arm-none-eabi-ranlib HINTS "${_arm_bin}" REQUIRED)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${_arm_bin}" REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${_arm_bin}" REQUIRED)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
